# garmin-live configuration — copy to `.env` and edit. Every variable the app reads is listed here.
# `.env` is gitignored; only this example file is committed.

# URL prefix the app is served under. "" (empty) = root. Matthew's deployment uses /garmin-mcp.
# Must start with "/" when set, and must not end with "/".
BASE_PATH=

# Unguessable path segment for the MCP endpoint: {BASE_PATH}/mcp/{MCP_PATH_SECRET}. This IS the
# credential (claude.ai custom connectors are authless or OAuth). Minimum 32 characters.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_PATH_SECRET=replace-me-with-a-random-string-of-at-least-32-characters

# SQLite database path (WAL mode). In Docker this lives on the /data volume.
DB_PATH=/data/garmin.db

# Days to keep sessions, trackpoints and events before the retention job purges them.
RETENTION_DAYS=30

# Optional: your max heart rate (bpm). Enables HR zone time in get_session_summary. Leave empty to disable.
ATHLETE_MAX_HR=

# How to fetch LiveTrack data: "http" (plain HTTPS requests) or "browser" (headless Chromium).
FETCH_STRATEGY=http

# Minimum seconds between polls of a LiveTrack session (actual interval = max(this, observed cadence)).
POLL_MIN_SECONDS=20

# A tracking session is force-ended after this many hours.
MAX_SESSION_HOURS=12

# Set to true to restrict access to the IPs listed in ALLOWED_IPS (read from X-Real-IP behind the proxy).
ENFORCE_IP_ALLOWLIST=false

# Comma-separated IPs or CIDRs allowed when ENFORCE_IP_ALLOWLIST=true. Example: 203.0.113.10,198.51.100.0/24
ALLOWED_IPS=

# Comma-separated hostnames the MCP transport accepts in the Host header (DNS-rebinding protection).
# Set this to your public domain(s). Example: example.com,www.example.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated IPs/CIDRs of the reverse proxy that is trusted to set X-Real-IP. Leave empty to
# trust private-network proxies (Docker bridge). Only used when ENFORCE_IP_ALLOWLIST=true.
TRUSTED_PROXY_CIDRS=

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
